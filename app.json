{
  "expo": {
    "name": "Brain Bee Prep",
    "slug": "BrainBeePrep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon2.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E27"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brainbeeprep.app",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E27",
        "foregroundImage": "./assets/icon2.png"
      },
      "package": "com.brainbeeprep.app"
    },
    "plugins": [
      "react-native-reanimated"
    ],
    "web": {
      "favicon": "./assets/icon2.png"
    },
    "extra": {
      "eas": {
        "projectId": "cd3bd5e7-264a-4c76-b368-07147943e8f7"
      }
    }
  }
}
